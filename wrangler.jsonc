{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frig-web",
  "main": "workers/asset-rewrites.js",
  "compatibility_date": "2026-11-21",
  "workers_dev": false,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/menu/*",
      "/login/*",
      "/warehouses/*",
      "/kds/station/*",
      "/checkout/pay-installment/*",
      "/reset-password/*",
      "/survey/*",
      "/salon-test",
      "/salon-test/"
    ]
  },
  "routes": [
    { "pattern": "frig.yggdra.cl/*", "zone_name": "yggdra.cl" },
    { "pattern": "www.frig.yggdra.cl/*", "zone_name": "yggdra.cl" },
    { "pattern": "intranet.macanuobowl.cl/*", "zone_name": "macanuobowl.cl" }
  ]
}
